# Overlay to provide [FMS Standard labels](http://www.fms-standard.com/Truck/index.htm) in VSS 3.0
# Dependencies to other overlays: None
# Known conflicts with other overlays: None
#
# The Data Entries are sorted lexicographically
#
# All entries that are part of standard VSS 5.0 are commented out.
# They should be uncommented and amended with DBC mapping information in order
# to use this file with Kuksa's CAN provider.

Vehicle.CurrentLocation.Speed:
  datatype: float
  type: sensor
  unit: km/h
  description: The vehicle's current speed as as measured by the GNSS receiver antenna.

Vehicle.Powertrain.FuelSystem.Tank:
  type: branch
  instances: ["First","Second"]
  description: Information about the first and (optional) second fuel tank.

Vehicle.Powertrain.FuelSystem.Tank.First.RelativeLevel:
  datatype: float
  type: sensor
  unit: percent
  description: |
    The relative level of the first fuel tank, expressed as a percentage of the total capacity.
# place j1939 mapping info here

Vehicle.Powertrain.FuelSystem.Tank.Second.RelativeLevel:
  datatype: float
  type: sensor
  unit: percent
  description: |
    The relative level of the second fuel tank, expressed as a percentage of the total capacity.
# place j1939 mapping info here

Vehicle.Powertrain.TractionBattery.CoolantTemperature:
  datatype: float
  type: sensor
  unit: Celsius
  description: |
    The temperature of the battery pack coolant.
  # map to PGN61589 (HVESSD6 - High Voltage Energy Storage System Data 6) - SP8089 HVESS Outlet Coolant Temperature

Vehicle.Cabin.Tachograph.Drivers.Driver1.CardIssuingMemberState:
  datatype: string
  type: attribute
  description: The country alpha code of the Member State having issued the card.
  default: "DE"

Vehicle.Cabin.Tachograph.Drivers.Driver2.CardIssuingMemberState:
  datatype: string
  type: attribute
  description: The country alpha code of the Member State having issued the card.
  default: "DE"

Vehicle.Driver.Identifier:
  type: branch
  description: Attributes related to the identifier of a driver of the vehicle.

Vehicle.Driver.Identifier.Subject:
  datatype: string
  type: attribute
  description: The unique identification of a driver in a Member State.
  default: "DRIVERxxxxxxxxxx"
